# ========================================================
# SmartRoute • Environment Variables Template
# ========================================================
# Note: The project runs completely out-of-the-box with NO
# API keys required using local storage and public OSRM routing.
# 
# To connect to an optional remote Supabase PostgreSQL database,
# copy this file to .env and insert your project credentials below.

# Supabase Project URL (Optional)
VITE_SUPABASE_URL=

# Supabase Public Anon Key (Optional)
VITE_SUPABASE_ANON_KEY=
